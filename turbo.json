{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV", "DATABASE_URL", "REDIS_URL",
    "JWT_ACCESS_SECRET", "JWT_REFRESH_SECRET", "JWT_ISSUER",
    "API_PORT", "WEB_ORIGIN", "NEXT_PUBLIC_API_URL", "ANTHROPIC_API_KEY",
    "MAIL_DRIVER", "MAIL_FROM", "MAIL_REPLY_TO", "MAIL_OUTBOX_DIR", "RESEND_API_KEY",
    "SMTP_HOST", "SMTP_PORT", "SMTP_SECURE", "SMTP_USER", "SMTP_PASSWORD",
    "S3_BUCKET", "S3_REGION", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY", "S3_ENDPOINT", "S3_PUBLIC_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^build"] },
    "check-types": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "cache": false },
    "migrate": { "cache": false },
    "seed": { "cache": false }
  }
}
