# ─────────────────────────────────────────────────────────────
# m.on — production. Copy to .env.production and fill in.
# `pnpm prod:up` reads this file. NEVER commit the filled copy.
#
# Every secret here must be generated fresh for production. Reusing a
# development JWT secret means anybody who has ever had the repo checked out
# can mint an administrator session.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# ─── Database ───────────────────────────────────────────────
# No host or port: docker-compose.prod.yml keeps Postgres on an internal
# network with no published ports, and the API reaches it by service name.
POSTGRES_USER=mon
POSTGRES_PASSWORD=
POSTGRES_DB=mon
DATABASE_URL=postgresql://mon:<same password>@postgres:5432/mon

REDIS_PASSWORD=
REDIS_URL=redis://:<same password>@redis:6379

# ─── Secrets ────────────────────────────────────────────────
# Generate each separately: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_HINT_SECRET=
JWT_ISSUER=mon-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Hosts ──────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=https://api.moveongo.de
WEB_ORIGIN=https://moveongo.de
NEXT_PUBLIC_API_URL=https://api.moveongo.de

# REQUIRED in production, unlike development. The API and the web app are
# separate hostnames here, and without a parent domain the session hint the API
# sets never reaches the origin whose middleware reads it — every signed-in
# user is bounced to /login.
SESSION_COOKIE_DOMAIN=.moveongo.de

BUSINESS_TIMEZONE=Europe/Berlin

# ─── Outbound email ─────────────────────────────────────────
# Namecheap Private Email. Use an application password, never the master one.
# Single-quote the value: these passwords often contain '#', which dotenv
# otherwise reads as a comment and truncates.
# resend, not smtp: this host blocks outbound 25/465/587, which is DigitalOcean's
# default for new accounts. Resend sends over 443. Switch to smtp only once that
# block is lifted and `nc -vz mail.privateemail.com 465` succeeds from the server.
MAIL_DRIVER=resend
RESEND_API_KEY=

# Kept for the smtp driver, unused while MAIL_DRIVER=resend.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@moveongo.de
SMTP_PASSWORD=''
MAIL_FROM="m.on <info@moveongo.de>"
MAIL_REPLY_TO=info@moveongo.de

# Before trusting this: the sending domain needs SPF, DKIM and DMARC records,
# or valid credentials still produce mail that lands in spam. Verify after
# deploying with GET /api/admin/mail/status and POST /api/admin/mail/test.

ANTHROPIC_API_KEY=
GEOCODING_USER_AGENT="m.on/1.0 (info@moveongo.de)"

# Leave blank after the first deploy — the admin already exists, and a password
# sitting in an env file is one more place it can leak from.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
