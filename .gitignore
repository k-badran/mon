# dependencies
node_modules/
.pnpm-store/

# secrets — never commit
.env
.env.*
!.env.example
# `.env.*` above would otherwise swallow this one too, and it holds no secrets:
# it is the template README tells you to copy to .env.production.
!.env.production.example

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# turborepo
.turbo/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# recorded mail from MAIL_DRIVER=log — real recipient addresses, never commit
.mail-outbox/

# test / coverage
coverage/
*.pdf
*.zip
backups/
.env.production
