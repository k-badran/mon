# ─────────────────────────────────────────────────────────────
# m.on — copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL — matches docker-compose.dev.yml.
# Replace user/password/host with your own database credentials.
DATABASE_URL=postgresql://mon:mon@localhost:5432/mon_dev

# Redis — cache, rate limiting, and real-time pub/sub
REDIS_URL=redis://:redis@localhost:6390

# JWT — generate each with: openssl rand -base64 48
# These MUST be different from each other and must never reach the browser.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string

# Signs the session hint cookie, which the web app's middleware verifies at the
# edge to decide where to send a visitor before a page renders.
#
# Optional, and separate from JWT_ACCESS_SECRET on purpose: the Next.js process
# must hold whichever key verifies the hint, and while that was the access
# secret, any disclosure from the web tier was also the key that mints API
# sessions. Left blank, apps/web/next.config.js derives this key from the
# access secret by a one-way hash and the access secret itself never enters the
# web process's environment.
#
# Never give this or JWT_ISSUER a NEXT_PUBLIC_ prefix — that inlines the value
# into the browser bundle, which for a signing key means publishing it.
JWT_HINT_SECRET=
JWT_ISSUER=mon-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Web (Next.js)
WEB_PORT=3200
WEB_ORIGIN=http://localhost:3200
NEXT_PUBLIC_API_URL=http://localhost:4000

# The domain the session hint cookie is scoped to, e.g. .moveongo.de.
#
# Left blank in development on purpose: the API and the web app share a host
# and differ only by port, which cookies ignore. In production they are
# separate hostnames and this becomes REQUIRED — without it the hint the API
# sets never reaches the origin whose middleware reads it, and every signed-in
# user is bounced to /login. Only the hint follows this; the refresh cookie
# stays host-only because it is a credential.
SESSION_COOKIE_DOMAIN=

# Business timezone — all booking-day logic is pinned to this
BUSINESS_TIMEZONE=Europe/Berlin

# ─── Outbound email ───────────────────────────────────────────
# MAIL_DRIVER picks the transport:
#   log  — writes each message to MAIL_OUTBOX_DIR as an openable .html file and
#          sends nothing. The default outside production, and what you want
#          locally: no credentials needed, tests cannot email a real customer,
#          and it works on networks that block outbound SMTP (most home and
#          mobile connections block ports 25/465/587 — check with
#          `nc -vz mail.privateemail.com 465` before assuming a bug).
#   resend — real delivery over Resend's HTTP API, on port 443. Prefer this
#          wherever SMTP is blocked, which is most home networks and every new
#          DigitalOcean droplet (that provider blocks 25/465/587 by default).
#   smtp — real delivery over SMTP. Needs port 465 or 587 to be reachable.
# Left unset it resolves to smtp when NODE_ENV=production, log otherwise.
MAIL_DRIVER=log
MAIL_OUTBOX_DIR=.mail-outbox

# Required when MAIL_DRIVER=resend. Create a Sending-access key at
# resend.com/api-keys; the sending domain must be verified there first.
RESEND_API_KEY=

# Namecheap Private Email. Port 465 with SMTP_SECURE=true (implicit TLS), or
# 587 with SMTP_SECURE=false (STARTTLS). Unencrypted connections are refused by
# the server. SMTP_USER is the full address, not a mailbox name.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@moveongo.de
# Wrap the password in SINGLE quotes. Passwords from the Private Email
# generator routinely contain '#', which dotenv reads as the start of a comment
# and truncates — the symptom is an authentication failure with a password that
# looks correct in the file. Use an application password, not the master one.
SMTP_PASSWORD=''

# The From domain must match the SMTP account's domain, or SPF will not align
# and the mail is treated as spoofed however valid the credentials are.
MAIL_FROM="m.on <info@moveongo.de>"
MAIL_REPLY_TO=info@moveongo.de

# Assistant
ANTHROPIC_API_KEY=

# Geocoding (server-side proxy). Nominatim requires an identifying contact.
GEOCODING_USER_AGENT="m.on/1.0 (info@moveongo.de)"

# Seed admin — used by `pnpm seed`
SEED_ADMIN_EMAIL=admin@moveongo.de
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
