# ─────────────────────────────────────────────────────────────
# UmzugPlus — copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL — matches docker-compose.dev.yml.
# Replace user/password/host with your own database credentials.
DATABASE_URL=postgresql://umzugplus:umzugplus@localhost:5432/umzugplus_dev

# Redis — cache, rate limiting, and real-time pub/sub
REDIS_URL=redis://:redis@localhost:6390

# JWT — generate each with: openssl rand -base64 48
# These MUST be different from each other and must never reach the browser.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string

# Signs the session hint cookie, which the web app's middleware verifies at the
# edge to decide where to send a visitor before a page renders.
#
# Optional, and separate from JWT_ACCESS_SECRET on purpose: the Next.js process
# must hold whichever key verifies the hint, and while that was the access
# secret, any disclosure from the web tier was also the key that mints API
# sessions. Left blank, apps/web/next.config.js derives this key from the
# access secret by a one-way hash and the access secret itself never enters the
# web process's environment.
#
# Never give this or JWT_ISSUER a NEXT_PUBLIC_ prefix — that inlines the value
# into the browser bundle, which for a signing key means publishing it.
JWT_HINT_SECRET=
JWT_ISSUER=umzugplus-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Web (Next.js)
WEB_PORT=3200
WEB_ORIGIN=http://localhost:3200
NEXT_PUBLIC_API_URL=http://localhost:4000

# The domain the session hint cookie is scoped to, e.g. .umzugplus.de.
#
# Left blank in development on purpose: the API and the web app share a host
# and differ only by port, which cookies ignore. In production they are
# separate hostnames and this becomes REQUIRED — without it the hint the API
# sets never reaches the origin whose middleware reads it, and every signed-in
# user is bounced to /login. Only the hint follows this; the refresh cookie
# stays host-only because it is a credential.
SESSION_COOKIE_DOMAIN=

# Business timezone — all booking-day logic is pinned to this
BUSINESS_TIMEZONE=Europe/Berlin

# Outbound email
RESEND_API_KEY=
MAIL_FROM="UmzugPlus <info@umzugplus.de>"

# Assistant
ANTHROPIC_API_KEY=

# Geocoding (server-side proxy). Nominatim requires an identifying contact.
GEOCODING_USER_AGENT="UmzugPlus/1.0 (info@umzugplus.de)"

# Seed admin — used by `pnpm seed`
SEED_ADMIN_EMAIL=admin@umzugplus.de
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
