# ─────────────────────────────────────────────────────────────
# UmzugPlus — copy to .env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL — matches docker-compose.dev.yml.
# Replace user/password/host with your own database credentials.
DATABASE_URL=postgresql://umzugplus:umzugplus@localhost:5432/umzugplus_dev

# Redis — cache, rate limiting, and real-time pub/sub
REDIS_URL=redis://:redis@localhost:6390

# JWT — generate each with: openssl rand -base64 48
# These MUST be different from each other and must never reach the browser.
#
# JWT_ACCESS_SECRET and JWT_ISSUER are also read by the web app's Node process:
# its middleware verifies the session hint cookie at the edge before a page
# renders. apps/web/next.config.js copies just those two out of this file.
# Never give either a NEXT_PUBLIC_ prefix — that inlines the value into the
# browser bundle, which for a signing secret means publishing it.
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-string
JWT_ISSUER=umzugplus-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000

# Web (Next.js)
WEB_PORT=3200
WEB_ORIGIN=http://localhost:3200
NEXT_PUBLIC_API_URL=http://localhost:4000

# Business timezone — all booking-day logic is pinned to this
BUSINESS_TIMEZONE=Europe/Berlin

# Outbound email
RESEND_API_KEY=
MAIL_FROM="UmzugPlus <info@umzugplus.de>"

# Assistant
ANTHROPIC_API_KEY=

# Geocoding (server-side proxy). Nominatim requires an identifying contact.
GEOCODING_USER_AGENT="UmzugPlus/1.0 (info@umzugplus.de)"

# Seed admin — used by `pnpm seed`
SEED_ADMIN_EMAIL=admin@umzugplus.de
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Admin
